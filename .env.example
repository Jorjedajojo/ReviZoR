# ReviZoR FranK — Environment Configuration
# Copy this file to .env and fill in all values
# The .env file must NEVER be committed to version control

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auth server (required for deployed/online version) ────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_strong_random_secret_key_here

# First-run admin account (used only if no admin exists in the database)
# Leave ADMIN_PASSWORD blank to auto-generate a random password on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@yourdomain.com

# ── Session & security settings ───────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480    # 8 hours — adjust per your policy
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_ATTEMPTS=5              # Attempts before account lockout
LOCKOUT_MINUTES=30                 # How long accounts stay locked

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── Streamlit (set this when running in deployed mode) ───────────────────────
# Points the Streamlit app to the FastAPI auth server
# Leave blank for local single-user desktop use (no login gate)
API_BASE_URL=https://yourdomain.com

# ── Admin dashboard (separate credentials from regular user) ─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# ── Currency conversion for P&L report ───────────────────────────────────────
USD_TO_EGP_RATE=50

# ── n8n Integration ──────────────────────────────────────────────────────────
# Webhook URL from your n8n workflow (the "Webhook" trigger node URL).
# Found in n8n: open your workflow → click the Webhook node → copy "Test URL"
# for dev or "Production URL" for live use.
N8N_WEBHOOK_URL=https://your-n8n.yourdomain.com/webhook/revizor-review

# Shared secret for request signing (HMAC-SHA256).
# Must match the value configured in your n8n workflow's "Respond" node header.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
N8N_CALLBACK_SECRET=generate_a_strong_random_secret_here

# Base URL of THIS FastAPI server — n8n uses this to know where to POST results.
# Must be reachable from your n8n instance (not localhost unless both are local).
APP_CALLBACK_URL=https://yourdomain.com

# Seconds to wait for n8n webhook acknowledgement before timing out (default 10)
N8N_TIMEOUT_SECS=10

# ── Supabase (free-tier PostgreSQL) ──────────────────────────────────────────
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
